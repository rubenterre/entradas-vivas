<style>

.catalog__filters{
    display: flex;
    justify-content: start;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0px;
}

  .filter-btn {
    display: flex;
    justify-content: start;
    align-items: center;
    gap: 10px;
    width: 200px;
    height: 40px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    background: transparent;
    color: var(--light);
    padding: 0px 10px;
  }

  .catalog__grid{
    display: grid;
    grid-template-columns: repeat(3, minmax(320px, 1fr));
    margin: 1.5rem 0px;
  }
</style>
