---

<div class="catalog__filters" id="filters">
  <button data-filter="all" class="filter-btn filter-btn--active">
    Todos
  </button>
  <button
    type="button"
    data-filter="category"
    class="filter-btn"
    aria-label="Filtrar por categoría"
  >
    <img
      src={category.src}
      alt="Icono de categoría"
      class="filter-btn__icon"
      width="20"
      height="20"
      decoding="async"
    />
    Categorías
  </button>
  <!--     {filters.map((filter) => (
      <button data-filter={filter} class="filter-btn">
        {filter}
      </button>
    ))} -->
</div>

<div class="catalog__grid" id="catalog-grid">
  <!--     {items.map((item) => (
      <article
        class="catalog__card"
        data-category={item.category}
      >
        <h3>{item.title}</h3>
        <p>{item.category}</p>
        <a href={`/entradas/${item.slug}`}>Ver entrada</a>
      </article>
    ))} -->
    <Card/>
</div>

