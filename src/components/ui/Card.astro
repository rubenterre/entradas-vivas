---
interface Asset {
  id?: number;
  filename: string;
  alt?: string;
  name?: string;
  title?: string;
  copyright?: string;
  fieldtype?: string;
}

interface RichText {
  type: string;
  content?: any[];
}

interface Props {
  title: string;
  slug: string;
  category: string;
  url?: string;
  description?: RichText;
  image?: Asset;
  images?: Asset[];
  price?: number | string;
  class?: string;
}

const {
  title,
  slug,
  category,
  url,
  description,
  image,
  images,
  price,
  class: className,
} = Astro.props as Props;

// Imagen principal: usa image, y si no, la primera de images
const mainImage = image || images?.[0];
const detailUrl = url || `/${slug}`;

// Precio formateado simple (puedes mejorarlo luego)

let priceNumber: number | null = null;

if (typeof price === "number") {
  priceNumber = price;
} else if (typeof price === "string") {
  const parsed = Number(price.replace(",", "."));
  priceNumber = Number.isNaN(parsed) ? null : parsed;
}

const priceLabel =
  priceNumber !== null
    ? `€ ${priceNumber.toFixed(2)}`
    : "Consultar";


---


<article
  class={`ticket-card ${className || ""}`}
  data-category={category}
>
  <div class="ticket-card__image-wrapper">
    {mainImage ? (
      <img
        src={mainImage.filename}
        alt={mainImage.alt || title}
        loading="lazy"
      />
    ) : (
      <div class="ticket-card__image-placeholder">
        Sin imagen
      </div>
    )}

    <button class="ticket-card__fav" type="button">
      <span>♡</span>
    </button>
  </div>

  <div class="ticket-card__body">
    <h3 class="ticket-card__title">{title}</h3>

    <div class="ticket-card__price-row">
      <span class="ticket-card__price-label">Precio</span>
      <span class="ticket-card__price">{priceLabel}</span>
    </div>

    <hr class="ticket-card__divider" />

    <a href={detailUrl} class="ticket-card__cta">
      <span>Ver más detalles</span>
      <span class="ticket-card__cta-icon">+</span>
    </a>
  </div>
</article>


<style>
