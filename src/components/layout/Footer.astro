---
import logo from "../../assets/entradasvivas_logo.svg";
import instagramIcon from "../../assets/socials/instagram_icon.svg";
import vintedIcon from "../../assets/socials/vinted_icon.svg";
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <!-- Logo -->
       <a href="/" class="footer__a--logo">
      <div class="footer__column footer__brand">
        <img class="footer__logo" src={logo.src} alt="Entradas Vivas" />
      </div>
      </a>
      <!-- Mapa del sitio -->
      <nav class="footer__column">
        <h3 class="footer__heading">Mapa del sitio</h3>
        <ul class="footer__list">
          <li><a href="/">Inicio</a></li>
          <li><a href="/catalogo">Catálogo</a></li>
          <li><a href="/experiencia">Experiencia</a></li>
          <li><a href="/peticiones">Peticiones</a></li>
          <li><a href="/contacto">Contacto</a></li>
        </ul>
      </nav>

      <!-- Aviso legal -->
      <nav class="footer__column">
        <h3 class="footer__heading">Aviso legal</h3>
        <ul class="footer__list">
          <li><a href="/aviso-legal">Aviso legal</a></li>
          <li><a href="/privacidad">Política de privacidad</a></li>
          <li><a href="/condiciones">Condiciones del servicio</a></li>
          <li><a href="https://rubenterre.com">Créditos</a></li>
        </ul>
      </nav>

      <!-- Contacto -->
      <div class="footer__column footer__column--contact">
        <h3 class="footer__heading">Contacto</h3>
        <ul class="footer__list">
          <li><a href="/contacto">Ayuda</a></li>
        </ul>

        <div class="footer__social">
          <p class="footer__social-label">Síguenos</p>
          <div class="footer__social-icons">
            <a
              href="https://www.instagram.com/entradasvivas"
              aria-label="Instagram"
            >
              <span class="social-icon">
                <img src={instagramIcon.src} alt="Icono de Instagram" />
              </span>
            </a>
            <a
              href="https://www.vinted.es/member/218969721"
              aria-label="Vinted"
            >
              <span class="social-icon">
                <img src={vintedIcon.src} alt="Icono de Vinted" />
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="footer__divider"></div>

    <div class="footer__bottom">
      <p class="footer__copy">
        © 2026 Entradas Vivas de Irina Meixus - Diseñado y desarrollado por <a class="footer__a" href="https://rubenterre.com" target="_blank">Rubén Terré</a> 
      </p>
      <div class="footer__bottom-links">
        <a href="/privacidad">Política de privacidad</a>
        <a href="/condiciones">Condiciones del servicio</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--card-bg);
    color: var(--light);
    padding: 3rem 0 2rem;
    font-family: var(--font-secondary);
  }

  .footer__top {
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
  }

  .footer__logo{
    width: 140px;
    max-height: 99px;
  }

  .footer__heading {
    font-family: var(--font-primary);
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 0.8rem;
    color: var(--white);
  }

  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__list li {
    margin-bottom: 0.3rem;
  }

  .footer__list a {
    font-family: var(--font-secondary);
    color: var(--text-secondary);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .footer__list a:hover {
    color: var(--main-color);
  }

  .footer__a--logo{
    text-decoration: none;
  }

  .footer__a{
        font-family: var(--font-secondary);
    color: var(--text-secondary);
  }

  .footer__a:hover{
    color: var(--main-color);
  }

  .footer__column--contact {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  .footer__social-label {
    font-family: var(--font-primary);
    color: var(--light);
    font-size: 1.2rem;
    margin-bottom: 0.4rem;
  }

  .footer__social-icons {
    display: flex;
    gap: 0.7rem;
  }

  .social-icon {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: #1f2227;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    color: var(--light);
  }

  .footer__divider {
    margin: 2rem auto 1.5rem;
    border-bottom: 1px solid #24272d;
  }

  .footer__bottom {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .footer__copy {
    margin: 0;
  }

  .footer__bottom-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer__bottom-links a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .footer__bottom-links a:hover {
    color: var(--light);
  }

  @media (max-width: 900px) {


    .footer__top {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

  }

  @media (max-width: 640px) {
    .footer__top {
      grid-template-columns: 1fr;
    }

    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
