<script define:vars={{ particlesOptions }}>
  // Carga tsParticles desde CDN como script UMD
  const script = document.createElement("script");
  script.src = "https://cdn.jsdelivr.net/npm/tsparticles-engine@2.12.0/tsparticles.engine.min.js";
  script.onload = async () => {
    const mainScript = document.createElement("script");
    mainScript.src = "https://cdn.jsdelivr.net/npm/tsparticles@2.12.0/tsparticles.bundle.min.js";
    mainScript.onload = () => {
      const container = document.getElementById("bannerParticles");
      if (container && window.tsParticles) {
        window.tsParticles.load({
          id: "bannerParticles",
          element: container,
          options: particlesOptions,
        });
      }
    };
    document.body.appendChild(mainScript);
  };
  document.body.appendChild(script);
</script>

<style>
.banner-wrapper {
  background: var(--color-dark-bg);
  padding: 3rem 1.5rem;
  display: flex;
  justify-content: center;
}

.banner {
  position: relative;
  width: 100%;
  border-radius: 24px;
  overflow: hidden;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  background: var(--white);

}

.banner__h1{
  font-family: var(--font-secondary);
  color: var(--color-dark-bg);
  font-size: 2rem;
  font-weight: 400;
  margin-bottom: 1rem;
  line-height: 3rem;
}

.banner-buttons{
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
}

.btn{
  display: flex;
justify-content: center;
align-items: center;
gap: 10px;
padding: 10px;
height: 50px;
border-radius: 14px;
text-decoration: none;
font-family: var(--font-secondary);
}

.btn-secondary{
  background: var(--color-dark-bg);
  color: var(--light);
  font-size: 1rem;
  width: 190px;
  border: 2px solid transparent;
}

.btn-primary{
  background: var(--blue);
  color: var(--light);
  font-size: 1rem;
  width: 230px;
  border: 2px solid transparent;
}

.btn-secondary:hover{
  background: var(--light);
  color: var(--bg-elevated);
  font-size: 1rem;
  width: 190px;
  border: 2px solid var(--bg-elevated);

  & .btn__icon {
  filter: invert(1);
  transition: filter 0.2s ease;
}
}



.btn-primary:hover{
  background: var(--bg-elevated);
  color: var(--light);
  font-size: 1rem;
  width: 230px;
  border: 2px solid var(--bg-elevated);

}


/* El canvas de partículas se limita al rectángulo del banner */
.banner-particles {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
}

.banner-left{
  padding-left: 2rem;
}

/* contenido por encima del canvas */
.banner-left,
.banner-right {
  position: relative;
  z-index: 1;
}

.banner-right{
  height: 100%;
}

.banner__img{
  height: 100%;
}
</style>
