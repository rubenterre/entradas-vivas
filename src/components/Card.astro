---

---

        <article class="ticket-card">
          <div class="ticket-card__image-wrapper">
            <img
              src="/entradas/emilia_menes.webp"
              alt="Entrada conmemorativa de Emilia Mendes"
            />
            <button class="ticket-card__fav">
              <span>♡</span>
            </button>
          </div>

          <div class="ticket-card__body">
            <h3 class="ticket-card__title">
              Entrada conmemorativa de Emilia Mendes
            </h3>

            <div class="ticket-card__price-row">
              <span class="ticket-card__price-label">Precio</span>
              <span class="ticket-card__price">€ 4,38</span>
            </div>

            <hr class="ticket-card__divider" />

            <button class="ticket-card__cta">
              <span>Ver más detalles</span>
              <span class="ticket-card__cta-icon">+</span>
            </button>
          </div>
        </article>

        <style>
            .ticket-card__image-wrapper {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
  }

  .ticket-card__image-wrapper img {
    display: block;
    width: 100%;
    height: auto;
  }

  .ticket-card__fav {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: none;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--light);
    cursor: pointer;
  }

  .ticket-card__body {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .ticket-card__title {
    font-family: var(--font-secondary);
    font-size: 1.4rem;
    line-height: 1.35;
    font-weight: 400;
    padding: 10px 0px;
  }

  .ticket-card__price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-secondary)
  }

  .ticket-card__price-label {
    font-size: 1rem;
    color: var(--text-secondary);
  }

  .ticket-card__price {
    font-size: 1.2rem;
    font-weight: 600;
  }

  .ticket-card__divider {
    border: none;
    border-bottom: 1px solid #1b1f26;
    margin: 8px 0 0;
  }

  .ticket-card__cta {
    margin-top: 10px;
    width: 100%;
    border-radius: 12px;
    border: none;
    padding: 14px 18px;
    background: var(--blue);
    color: var(--light);
    font-family: var(--font-secondary);
    font-size: 1rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    cursor: pointer;
  }

  .ticket-card__cta-icon {
    font-size: 1.3rem;
    line-height: 0;
}
        </style>