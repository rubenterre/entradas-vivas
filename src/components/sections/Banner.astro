---
import { Image } from "astro:assets";
import arrow from "../../assets/icons/arrow_icon.svg";
import banner from "../../assets/images/banner_1.webp";

const particlesOptions = {
  background: { color: "transparent" },
  fullScreen: { enable: false, zIndex: 0 },
  particles: {
    number: { value: 80, density: { enable: true, area: 800 } },
    color: { value: "#111111" },
    links: {
      enable: true,
      color: "#111111",
      distance: 200,
      opacity: 0.35,
      width: 1,
    },
    move: {
      enable: true,
      speed: 1.2,
      direction: "none",
      outModes: { default: "out" },
    },
    opacity: { value: 0.45 },
    size: { value: 2, random: true },
  },
  interactivity: {
    events: {
      onHover: { enable: true, mode: "repulse" },
      onClick: { enable: false },
      resize: true,
    },
    modes: { repulse: { distance: 120 } },
  },
  detectRetina: true,
};
---

<section class="banner-wrapper">
  <div class="banner">
    <!-- contenedor del canvas -->
    <div id="bannerParticles" class="banner-particles"></div>

    <div class="banner-left">
      <h1 class="banner__h1">Crea tu propia entrada personalizada</h1>
      <div class="banner-buttons">
        <a href="/catalogo" class="btn btn-secondary">
          Catálogo
          <Image class="btn__icon" src={arrow} alt="Icono de flecha" />
        </a>
        <a href="/crear-entrada" class="btn btn-primary">
          Crea tu entrada
          <Image src={arrow} alt="Icono de flecha" />
        </a>
      </div>
    </div>

    <div class="banner-right hide-on-med-and-down">
      <Image
        class="banner__img"
        src={banner}
        alt="Imágenes de entradas de concierto"
      />
    </div>
  </div>
</section>

<script is:inline define:vars={{ particlesOptions }}>
  const engine = document.createElement("script");
  engine.src = "/libs/tsparticles/tsparticles.engine.min.js";

  engine.onload = () => {
    console.log("engine cargado", window.tsParticles);

    const bundle = document.createElement("script");
    bundle.src = "/libs/tsparticles/tsparticles.bundle.min.js";

    bundle.onload = () => {
      console.log("bundle cargado", window.tsParticles);

      const container = document.getElementById("bannerParticles");
      console.log("container", container);

      if (container && window.tsParticles) {
        window.tsParticles
          .load({
            id: "bannerParticles",
            element: container,
            options: particlesOptions,
          })
          .then((instance) => {
            console.log("tsParticles iniciado", instance);
          })
          .catch((err) => {
            console.error("Error al iniciar tsParticles", err);
          });
      } else {
        console.error("No hay container o tsParticles no está en window");
      }
    };

    document.body.appendChild(bundle);
  };

  document.body.appendChild(engine);
</script>

<style>
  .banner-wrapper {
    background: var(--color-dark-bg);
    padding: 3rem 1.5rem;
    display: flex;
    justify-content: center;
  }

  .banner {
    position: relative;
    width: 100%;
    border-radius: 24px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    background: var(--white);
  }

  .banner__h1 {
    font-family: var(--font-secondary);
    color: var(--color-dark-bg);
    font-size: 2rem;
    font-weight: 400;
    margin-bottom: 1rem;
    line-height: 3rem;
  }
