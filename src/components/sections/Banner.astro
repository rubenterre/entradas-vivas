  .banner-buttons {
    display: flex;
    gap: 1rem;
  }

  /* Base común */

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 10px;
    height: 50px;
    border-radius: 14px;
    font-family: var(--font-secondary);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    border: 1px solid transparent;
    transition:
      background-color 0.18s ease,
      color 0.18s ease,
      box-shadow 0.18s ease,
      transform 0.12s ease,
      border-color 0.18s ease;
  }

  /* Secundario: borde de color, fondo claro */

  .btn-secondary {
    background: var(--white);
      width: 190px;
    color: var(--text-in-bg);
    border-color: rgba(16, 12, 38, 0.14); /* sutil sobre fondo claro */
  }

  .btn-secondary .btn__icon {
    filter: brightness(0) saturate(100%) invert(9%) sepia(11%) saturate(1496%)
      hue-rotate(210deg) brightness(95%) contrast(90%);
  }

  /* hover secundario: chip cálido */

  .btn-secondary:hover {
    background: rgba(255, 123, 106, 0.16); /* accent-warm suave */
    border-color: var(--accent-warm);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(255, 123, 106, 0.35);
  }

  .btn-secondary:hover .btn__icon {
    filter: brightness(0) saturate(100%) invert(48%) sepia(64%) saturate(2090%)
      hue-rotate(329deg) brightness(102%) contrast(101%);
  }

  /* Primario: CTA coral */

  .btn-primary {
    background: var(--main-color);
    color: var(--white);
    width: 280px;
    border-color: var(--main-color);
    box-shadow: 0 4px 10px rgba(255, 48, 64, 0.45);
  }

  /* opcional: si el icono es oscuro, acláralo sobre el rojo */
  .btn-primary img {
    filter: brightness(0) invert(1);
  }

  /* hover primario: transición a acento cálido + toque violeta */

  .btn-primary:hover {
    background: linear-gradient(
      90deg,
      var(--main-color),
      var(--accent-warm),
      var(--blue)
    );
    background-size: 180% 100%;
    background-position: 0% 50%;
    border-color: var(--accent-warm);
    transform: translateY(-1px);
    box-shadow: 0 8px 10px rgba(255, 48, 64, 0.55);
  }

  /* estado active para ambos */

  .btn:active {
    transform: translateY(0);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.3);
  }

  /* El canvas de partículas se limita al rectángulo del banner */
  .banner-particles {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  /* contenido por encima del canvas */
  .banner-left,
  .banner-right {
    position: relative;
    z-index: 1;
  }

  .banner-left {
    padding: 2.5rem;
  }

  .banner-right {
    height: 100%;
  }

  .banner__img {
    height: 100%;
  }

  @media (max-width: 800px) {
    .banner {
      display: flex;
      flex-direction: column;
      padding: 1.5rem;
    }

    .banner__h1 {
      font-size: 1.7rem;
      line-height: 2rem;
      text-align: center;
    }

    .banner-buttons {
      display: flex;
      flex-direction: column;
      gap: 10px;
      align-items: center;
    }

    .btn-secondary {
      width: 100%;
    }

    .btn-primary {
      width: 100%;
    }
  }
</style>
