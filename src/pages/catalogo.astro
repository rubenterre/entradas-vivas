---
import Layout from "../layouts/Layout.astro";
import TitlePage from "../components/ui/TitlePage.astro";
import Header from "../components/layout/Header.astro";
import Catalog from "../components/sections/Catalog.astro";
import { getTicketsAndFilters } from "../libs/getTickets.js";

const { items } = await getTicketsAndFilters();
---

<Layout>
  <div class="container">
    <Header />
    <TitlePage
      titular="Explorar catálogo"
      subtitular="Explora todas las entradas conmemorativas y encuentra la tuya para recordar tus mejores conciertos y festivales."
    />
    <section class="catalog">
      <Catalog items={items} />
    </section>
  </div>
</Layout>
