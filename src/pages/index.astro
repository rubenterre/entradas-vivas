---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import TicketSlider from "../components/features/TicketSlider.astro";
import arrow from "../assets/icons/arrow_icon.svg";
import arrowBlack from "../assets/icons/arrow_icon-black.svg";
import Recommended from "../components/sections/Recommended.astro";
import Steps from "../components/sections/Steps.astro";
import Banner from "../components/sections/Banner.astro";
import Catalog from "../components/sections/Catalog.astro";
import Title from "../components/ui/Title.astro";
import Button from "../components/ui/Button.astro";
---

<Layout>
  <section class="hero">
    <div class="container">
      <Header />
      <div class="hero__content">
        <h1 class="hero__h1">Revive la magia de tus conciertos favoritos</h1>
        <p class="hero__p">
          Entradas diseñadas para recordar cómo sonaba, con quién fuiste y lo
          que sentiste.
        </p>
        <div class="hero__buttons">
          <Button
            variant="secondary"
            href="/catalogo"
            label="Descubre más"
          />
          <Button
            variant="primary"
            href="/peticiones"
            label="Crea tu propia entrada"
          />
        </div>
      </div>
    </div>

    <TicketSlider />
  </section>

  <div class="container">
    <Recommended />
    <Steps />
    <Banner />
    <Title title="Revivir experiencias" url="/catalogo" />
    <Catalog />
  </div>
</Layout>

<style>
  .hero {
    background:
      linear-gradient(
        180deg,
        rgb(34 22 59 / 97%) 0%,
        rgb(34 22 59 / 76%) 40%,
        rgba(34, 22, 59, 1) 100%
      ),
      url(../assets/aplausos_fondo_hero.webp);

    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }
  .hero__content {
    max-width: 628px;
    padding: 1rem;
    margin: 0 auto;
  }

  .hero__h1 {
    font-family: var(--font-primary);
    color: var(--light);
    font-weight: 400;
    font-size: 3rem;
    text-align: center;
    margin-top: 3rem;
  }

  .hero__p {
    font-family: var(--font-secondary);
    color: var(--text-secondary);
    font-size: 1rem;
    font-weight: 400;
    text-align: center;
    line-height: 22px;
    margin-top: 2rem;
  }

.hero__buttons {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 2rem;
}

/* base común */

.hero__buttons a {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.85rem 1.7rem;
  border-radius: 12px;
  font-family: var(--font-secondary);
  font-size: 0.95rem;
  font-weight: 500;
  text-decoration: none;
  cursor: pointer;
  height: 44px;
  transition:
    all 0.18s ease;
}

/* botón “Descubre más”: secundario sobre fondo claro */

.hero__button-descubre {
  height: 44px;
  background: var(--light);
  color: var(--text-in-bg);
}

.hero__button-descubre .btn__icon {
  filter: brightness(0) saturate(100%) invert(9%) sepia(11%) saturate(1496%)
    hue-rotate(210deg) brightness(95%) contrast(90%);
}

.hero__button-descubre:hover {
  background: var(--text-secondary);
  transform: translateY(-1px);
}

.hero__button-descubre:hover .btn__icon {
  filter: brightness(0) saturate(100%) invert(48%) sepia(64%) saturate(2090%)
    hue-rotate(329deg) brightness(102%) contrast(101%);
}

/* botón “Crea tu propia entrada”: principal en azul violeta */

.hero__button-form {
  background: var(--blue);
  color: var(--white);
  height: 44px;
}

/* icono claro sobre fondo oscuro */
.hero__button-form .btn__icon {
  filter: brightness(0) invert(1);
}

/* hover: mezcla azul + coral para darle carácter de CTA */

.hero__button-form:hover {
  background: linear-gradient(
    90deg,
    var(--blue),
    var(--main-color)
  );
  background-size: 180% 100%;
  background-position: 0% 50%;
 transform: translateY(-1px);
}

/* estado activo común */

.hero__buttons a:active {
  transform: translateY(0);
  box-shadow: 0 8px 18px rgba(0, 0, 0, 0.3);
}

  @media (max-width: 550px) {

      .hero {
    background:
      linear-gradient(
        180deg,
        rgb(34 22 59 / 97%) 0%,
        rgb(34 22 59 / 76%) 40%,
        rgba(34, 22, 59, 1) 100%
      ),
      url(../assets/aplausos_fondo_hero.webp);

    background-position: top;
    background-size: cover;
    background-repeat: no-repeat;
  }

    .hero__buttons {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
    }

    .hero__button-descubre {
      width: 100%;
    }

    .hero__button-form {
      width: 100%;
    }
  }
</style>
